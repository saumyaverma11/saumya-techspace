PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Frontend URL (comma-separated if multiple domains, e.g. https://portfolio.vercel.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Backend URL (used for email action links like approve/reject resume requests, e.g. https://portfolio-api.onrender.com)
BACKEND_URL=http://localhost:5000

# Email Notifications (Gmail SMTP via Google App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
CONTACT_RECEIVER=your_email@gmail.com

# Authentication & Tokens
JWT_SECRET=your_strong_jwt_secret_key
JWT_EXPIRES_IN=1d
RESUME_TOKEN_EXPIRE_DAYS=7

# Persistent Production Storage (Cloudinary)
# If not provided, falls back to local disk storage in server/uploads/ during development
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
